# Supabase (free tier). Absent -> server runs on in-memory stores (dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server. Render injects PORT. HOST defaults to 0.0.0.0 for hosting.
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173

# Simulator agent (OpenRouter free tier: 20 req/min, 50/day).
# Absent -> /sim/chat streams error events; use Replay mode.
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openrouter/free
SIM_DAILY_BUDGET_CALLS=500
SIM_SESSION_MAX_TURNS=30

# Adapters (all keyless; override only for self-hosting).
NTFY_BASE_URL=https://ntfy.sh
RSS_FEED_URL=https://feeds.bbci.co.uk/news/rss.xml

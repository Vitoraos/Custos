# LLM (sole provider: OpenRouter — free tier: 20 req/min, 50/day,
# 1,000/day after a $10 lifetime purchase; failed requests count)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openrouter/free

# Supabase (Free Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MCP Server — Render injects PORT. Bind to it: process.env.PORT ?? 3000
PORT=3000
MCP_TRANSPORT_TYPE=http-stream
MCP_STATELESS=true

# Demo / failure injection
DEMO_MODE=false
CHAOS=

# LLM provider pool (any subset works; order = Groq, Workers AI, Gemini, OpenRouter)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_MODEL=@cf/openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openrouter/free

# Supabase (Free Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MCP Server — Render injects PORT. Bind to it: process.env.PORT ?? 3000
PORT=3000
MCP_TRANSPORT_TYPE=http-stream
MCP_STATELESS=true

# Demo / failure injection
DEMO_MODE=false
CHAOS=

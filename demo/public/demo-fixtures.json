                    "servings": 4,
                    "meal_type": "dinner"
                  }
                },
                {
                  "order": 2,
                  "description": "Check the recipe against stored restrictions",
                  "required_tool": null,
                  "expected_input": {}
                }
              ],
              "executor_trace": [

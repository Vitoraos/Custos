  "scenes": {
    "without_contextforge": [
      {
        "id": "F1",
        "title": "Preference amnesia",
        "caption": "Alexa+ ignores a stated dietary preference",
        "memory_panel": "empty",
        "turns": [
          {
            "speaker": "user",
            "text": "Alexa, I'm vegan. Plan dinner for 4 people.",
            "delay_ms": 0
          },
          {
            "speaker": "alexa",
            "text": "Great! How about a juicy steak dinner for 4? I can add ribeyes to your cart.",
            "delay_ms": 1200,
            "failure": "ignored_preference",
            "badge": "Ignored: vegan"
          },
          { "speaker": "user", "text": "I said I'm vegan.", "delay_ms": 1500 },
          {
            "speaker": "alexa",
            "text": "Sorry about that! How about grilled lemon-herb chicken?",
            "delay_ms": 1200,
            "failure": "ignored_preference_repeat",
            "badge": "Ignored again"
          },
          {
            "speaker": "user",
            "text": "...",
            "delay_ms": 1500,
            "annotation": "User gives up"
          }
        ]
      },
      {
        "id": "F2",
        "title": "Zero recall",
        "caption": "No memory across sessions (next day)",
        "memory_panel": "empty",
        "turns": [
          {
            "speaker": "user",
            "text": "Alexa, what did I ask you to remember yesterday?",
            "delay_ms": 0
          },
          {
            "speaker": "alexa",
            "text": "I don't have any stored preferences.",
            "delay_ms": 1200,
            "failure": "no_cross_session_memory",
            "badge": "No memory",
            "verbose_variant": "I don't have any stored preferences. By the way, did you know Alexa+ can help you discover new recipes with Prime?"
          }
        ]
      },
      {
        "id": "F3",
        "title": "Cannot chain steps",
        "caption": "One request, four tasks, one done",
        "memory_panel": "empty",
        "turns": [
          {
            "speaker": "user",
            "text": "Alexa, plan my morning: wake me at 7, start the coffee maker, read me the top 3 headlines, and tell me the weather.",
            "delay_ms": 0
          },
          {
            "speaker": "alexa",
            "text": "I can set an alarm for 7 AM. What else would you like?",
            "delay_ms": 1400,
            "failure": "no_multi_step",
            "badge": "1 of 4 steps"
          },
          {
            "speaker": "user",
            "text": "Start the coffee maker.",
            "delay_ms": 1500,
            "optional": true
          },
          {
            "speaker": "alexa",
            "text": "I can't do that right now. Would you like me to remind you to make coffee?",
            "delay_ms": 1200,
            "failure": "no_multi_step",
            "badge": "Still 1 of 4",
            "optional": true
          }
        ]
      }
    ],

    "with_contextforge": [
      {
        "id": "S1",
        "title": "Remember + plan",
        "caption": "States a preference once. ContextForge stores it and enforces it.",
        "memory_before": "before_S1",
        "memory_after": "after_S1",
        "user_say": "Alexa, I'm vegan. Plan dinner for 4 people.",
        "tool_calls": [
          {
            "tool": "store_preference",
            "args": {
              "user_id": "amzn1.account.DEMO-USER-001",
              "key": "diet",
              "value": "vegan",
              "category": "diet",
              "source": "explicit"
            },
            "result": "Preference stored: diet = vegan. This will be remembered for all future interactions.",
            "latency_ms": 180,
            "ui_delay_ms": 700
          },
          {
            "tool": "execute_workflow",
            "args": {
              "user_id": "amzn1.account.DEMO-USER-001",
              "task": "Plan dinner for 4 people",
              "max_steps": 10,
              "max_retries_per_step": 2
            },
            "workflow": {
              "loaded_preferences": [
                "diet=vegan",
                "allergies=peanuts",
                "home_city=Lagos"
              ],
              "loaded_instructions": [
                "Keep answers short. No jokes or upselling."
              ],

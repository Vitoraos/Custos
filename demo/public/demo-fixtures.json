{
  "_meta": {
    "name": "ContextForge demo fixtures",
    "version": "1.0",
    "purpose": "Deterministic replay data for the demo simulator. Runs with ZERO LLM calls so rate limits and cold starts can never break a take. Live mode (real MCP server + LLM) is optional and can be toggled on top.",
    "disclaimer": "The 'without_contextforge' scenes are an illustrative simulation of failure patterns reported by users, not recordings of real Alexa+ output. Show this caption on screen: 'Simulated Alexa+ behavior based on reported user issues.'",
    "fictional_data": "News headlines, recipes, device names and the demo account are invented for the demo.",
    "target_runtime_seconds": 165
  },


  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@strands-agents/sdk": "^1.19.0",
    "@supabase/supabase-js": "^2.0.0",

    "dotenv": "^18.0.6",
    "fastmcp": "^4.22.1",

    "fastmcp": "^4.22.4",

    "hono": "^4.13.13",
    "openai": "^7.28.0",
    "pino": "^10.4.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "check": "tsc --noEmit && biome check . && vitest run --passWithNoTests",
    "test": "vitest run",
    "db:seed": "tsx infra/seed.ts",
    "keys:create": "tsx scripts/keys-create.ts",
    "web:dev": "npm --prefix simulator/web run dev",
    "web:build": "npm --prefix simulator/web run build",
    "sim:record": "tsx scripts/sim-record.ts",
    "bench": "tsx bench/run.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:llm": "tsx bench/llm.ts",
    "smoke": "tsx scripts/smoke.ts"
  }
